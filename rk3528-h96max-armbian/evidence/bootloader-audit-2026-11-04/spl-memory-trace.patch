+void h96_trace(const char *stage)
+{
+ const struct driver *drv = DM_GET_DRIVER(rockchip_sfc_driver);
+ const struct udevice_id *ids = drv->of_match;
+ printascii("H96TRACE "); printascii(stage); printascii("\n");
+ h96_trace_hex("gd=", (ulong)gd);
+ h96_trace_hex("el=", current_el());
+ h96_trace_hex("sctlr=", get_sctlr());
+ h96_trace_hex("boot-source-raw=", readl(BROM_BOOTSOURCE_ID_ADDR));
+ h96_trace_hex("uart-baud=", gd->serial.baudrate);
+ h96_trace_hex("uart-addr=", gd->serial.addr);
+ h96_trace_hex("malloc_base=", gd->malloc_base);
+ h96_trace_hex("malloc_ptr=", gd->malloc_ptr);
+ h96_trace_hex("fdt=", (ulong)gd->fdt_blob);
+ h96_trace_hex("tlb=", gd->arch.tlb_addr);
+ h96_trace_hex("tlb_size=", gd->arch.tlb_size);
+ h96_trace_hex("ids=", (ulong)ids);
+ /* Do not dereference a corrupted match-table address. */
+ if ((ulong)ids >= (ulong)__image_copy_start &&
+     (ulong)ids + sizeof(*ids) <= (ulong)__image_copy_end)
+  h96_trace_hex("compatible=", (ulong)*(const char * volatile *)&ids->compatible);
+}
