From: H96 local board maintenance
Subject: [PATCH] rockchip: fail FIT generation when BL31 extraction fails

The decoder is Python 3 compatible. Avoid silently producing a FIT whose
configuration names atf-1 while no ATF image exists, including missing BL31.

--- a/arch/arm/mach-rockchip/decode_bl31.py
+++ b/arch/arm/mach-rockchip/decode_bl31.py
@@ -1,4 +1,4 @@
-#!/usr/bin/env python2
+#!/usr/bin/env python3
 #
 # Copyright (C) 2020 Rockchip Electronics Co., Ltd
 #
@@ -46,12 +46,7 @@
     elif os.path.isfile("./bl31.elf"):
         bl31_elf = "./bl31.elf"
     else:
-        os.system("echo 'int main(){}' > bl31.c")
-        os.system("${CROSS_COMPILE}gcc -c bl31.c -o bl31.elf")
-        bl31_elf = "./bl31.elf"
-        logging.basicConfig(format='%(levelname)s:%(message)s', level=logging.DEBUG)
-        logging.warning(' BL31 file bl31.elf NOT found, resulting binary is non-functional')
-        logging.warning(' Please read Building section in doc/README.rockchip')
+        raise FileNotFoundError('BL31 must name a valid firmware ELF; refusing a non-functional FIT')
     generate_atf_binary(bl31_elf);
 
 if __name__ == "__main__":
--- a/arch/arm/mach-rockchip/fit_nodes.sh
+++ b/arch/arm/mach-rockchip/fit_nodes.sh
@@ -110,7 +110,10 @@
 
 function gen_bl31_node()
 {
-	${srctree}/arch/arm/mach-rockchip/decode_bl31.py
+	if ! ${srctree}/arch/arm/mach-rockchip/decode_bl31.py; then
+		echo "BL31 extraction failed; refusing to generate FIT" >&2
+		exit 1
+	fi
 
 	NUM=1
 	for ATF in `ls -1 -S bl31_0x*.bin`
